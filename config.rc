# This file will be hot-reloaded.

# Set to false to hide the startup jblow wave gif.
show_startup_blow = false;

# Smaller values make larger text.
# e.g. 10 means 10 lines of text to full fill window height.
subtitle_font_size = 40;

# HUD switches and top-to-bottom order.
# Info rows follow file order;
hud_enabled            = true;
hud_show_notifications = true;
hud_hide_on_focus_loss = true;

# Top-left HUD items
hud_show_level_name    = true;
hud_show_position      = false;
# hud_text               = "\nLet's complete this game firstly\nand then play it twice!";
# hud_text               = "";                        # Blank line
hud_text               = "\nCurrent player: @qiekn";  # Custom notes, You can modify it!
hud_text               = "Cowabunga!\n";              # Multi-line

# Free camera (freecam): movement speed in world units per second, mouse look
# sensitivity in degrees per mouse count, and the speed multipliers applied
# while holding Shift or Ctrl. All values must be positive.
freecam_speed = 8;
freecam_sensitivity = 0.1;
freecam_shift_multiplier = 4;
freecam_ctrl_multiplier = 0.25;

# Time stop (shorcut key: P)
time_stop_alt_probability = 0.25; # easter egg version
time_stop_no_audio = false;       # immediately or audio version

# Game installation directory (contains sinking_star.exe, not its data/ folder).
# Use forward slashes; set to "" to locate the running game automatically.
game_path = "E:/SteamLibrary/steamapps/common/Order of the Sinking Star";

# Persistent aliases. Extra arguments are appended to the expanded command.

tp = back;

fastplay   = "play -superfast";
fastdo     = "play -superfast";
subtitles  = "show subtitles"
level_name = "show level";
go         = "switch"; # swtich level, e.g. swtich mirror_1

# Use alias name=command in the console for a temporary override.
# unalias name removes that override and restores this file's definition.


# Custom Keymaps
map m = "move -z 1";
map , = noclip;
map o = "show subtitles";
# map > = "speed up";
# map < = "speed down";
# map e = 'noclip';

# vim: ft=sh
