#!/bin/env jai

we_are_building_release_version := false;

output_name := "ootss-cmd";
output_path : string;

#run {
    build();
    set_build_options_dc(.{do_output=false});
}

build :: () {
    w := compiler_create_workspace("Our Target Program");
    if !w {
        log_error("Failed to create workspace");
        return;
    }

    // @TODO
    // User level cmd args
    // args := get_build_options().compile_time_command_line;
    // for args { ... }

    // Toplevel cmd args
    for get_toplevel_command_line() {
        if it == {
            case "-o";         #through;
            case "-optimized";
                we_are_building_release_version = true;
        }
    }

    // Build options
    options   := get_build_options();

    if we_are_building_release_version {
        set_optimization(*options, .OPTIMIZED);
        options.backend = .LLVM;
        output_path = tprint("%/bin", #filepath);
    } else {
        set_optimization(*options, .DEBUG);
        options.backend = .X64;
        output_path = #filepath;
    }

    options.output_executable_name = output_name;
    options.text_output_flags      = 0;           // -quiet
    options.emit_debug_info        = .NONE;       // no .pdb files
    options.output_path = output_path;            // debug version in project root, release version in 'bin'
    if !make_directory_if_it_does_not_exist(output_path) {
        log_error("Could not create output directory %.", output_path);
        return;
    }

    set_build_options(options, w);
    disable_runtime_console(w);

    compiler_begin_intercept(w);
    add_build_file("src/main.jai", w);
    message_loop();
    compiler_end_intercept(w);
}

message_loop :: () {
    succeeded := false;
    while true {
        message := compiler_wait_for_message();
        if message.kind == {
            case .COMPLETE;
                complete := cast(*Message_Complete) message;
                if complete.error_code == .NONE {
                    set_icon();
                    if we_are_building_release_version
                    then copy_data();
                }
                break;
        }
    }
}

set_icon :: () {
    icon := create_ico_file_from_bitmap_filename(tprint("%/data/images/icon.png", #filepath));
    defer free(icon);
    if false && !icon.count {
        compiler_report("Could not convert data/images/icon.png to a Windows icon.");
        return;
    }

    executable_filename := tprint("%/%.exe", output_path, output_name);
    if !set_icon_by_data(executable_filename, icon, resource_id = 2) {
        compiler_report(tprint("Could not embed the application icon in %.", output_name));
        return;
    }
}

// This procedure is generated by LLM
// 
// This procedure copy these fold and specific files to `bin/`
//
// - data/audio/
// - data/images/
// - datazork/
// - data/fonts/Meslo-LG-Mono-Nerd_regular.ttf (only this font in release version, other fonts will be auto loaded from user's OotSS game installation path)
// - data/custom_inputs.json
// - data/level_catelog.json
// - data/markers.json
// - data/solutions.json
// - data/subtitles.json
// - LICENSE
// - config.rc (never override if config.rc already exists)
// 
copy_data :: () -> bool {
    source      := tprint("%/data", #filepath);
    destination := tprint("%/data", output_path);
    UserData :: struct {
        source:      string;
        destination: string;
        success := true;
    }
    data: UserData = .{source = source, destination = destination};

    visitor :: (info: *File_Visit_Info, data: *UserData) {
        if !data.success return;
        relative := slice(info.full_name, data.source.count, info.full_name.count - data.source.count);
        // Only bundle Meslo; the other fonts are loaded from the game.
        if begins_with(relative, "/fonts/") && !equal_nocase(relative, "/fonts/Meslo-LG-Mono-Nerd-Regular.ttf") {
            if info.is_directory info.descend_into_directory = false;
            return;
        }
        // Saves and markers belong to each installation; never copy them from data/.
        if !info.is_directory && (ends_with_nocase(relative, ".sav") || equal_nocase(relative, "/markers.json")) return;
        target := tprint("%%", data.destination, relative);
        if info.is_directory {
            data.success = make_directory_if_it_does_not_exist(target);
            if !data.success info.descend_into_directory = false;
        } else data.success = copy_file(info.full_name, target);
    }

    if !make_directory_if_it_does_not_exist(destination) || !visit_files(source, true, *data, visitor, visit_directories = true) || !data.success {
        compiler_report(tprint("Could not copy data to %.", destination));
        return false;
    }
    license_destination := tprint("%/LICENSE", output_path);
    if !copy_file(tprint("%/LICENSE", #filepath), license_destination) {
        compiler_report(tprint("Could not copy LICENSE to %.", license_destination));
        return false;
    }
    // Keep an installation's edited copy;
    // Copy the default only when absent.
    config_destination := tprint("%/config.rc", output_path);
    if !file_exists(config_destination) && !copy_file(tprint("%/config.rc", #filepath), config_destination) {
        compiler_report(tprint("Could not copy config.rc to %.", config_destination));
        return false;
    }
    return true;
}


#import "Compiler";
#import "Basic";
#import "String";

#import "File";
#import "File_Utilities";

#import "Windows_Resources";
#import "Ico_File";
